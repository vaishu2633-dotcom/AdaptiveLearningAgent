# Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Adaptive Learning Path Agent"
API_V1_STR=/api/v1

# CORS - Allowed origins for development
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:8080","http://127.0.0.1:8081"]

# Database Configuration (PostgreSQL with psycopg driver)
# Note: Falls back gracefully to SQLite in local dev if PostgreSQL is unconfigured
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/adaptive_learning_db

# Future Agent Infrastructure (LangGraph & Vector Store)
OPENAI_API_KEY=
CHROMA_HOST=localhost
CHROMA_PORT=8000
